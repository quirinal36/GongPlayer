// 실행 파일 리소스: 아이콘, 앱 매니페스트, 버전 정보. build.rs가 rc.exe로 컴파일합니다.
#pragma code_page(65001)
// SDK 헤더 경로 없이 컴파일되도록 winver.h의 값을 직접 씁니다.

1 ICON "gongplayer.ico"
1 24 "gongplayer.exe.manifest"

1 VERSIONINFO
FILEVERSION GONG_VER_MAJOR,GONG_VER_MINOR,GONG_VER_PATCH,0
PRODUCTVERSION GONG_VER_MAJOR,GONG_VER_MINOR,GONG_VER_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041204B0"
    BEGIN
      VALUE "FileDescription", "GongPlayer"
      VALUE "ProductName", "GongPlayer"
      VALUE "FileVersion", GONG_VER_STR
      VALUE "ProductVersion", GONG_VER_STR
      VALUE "OriginalFilename", "GongPlayer.exe"
      VALUE "InternalName", "GongPlayer"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0412, 1200
  END
END
